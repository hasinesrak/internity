# Copy this file to .env. Docker Compose reads .env from this directory.

HOST=0.0.0.0

# Address other computers use to open this machine. Use the machine's LAN IP
# (for example 192.168.1.25) when sharing the Docker deployment over a LAN.
# Keep localhost for a deployment used only on this machine.
APP_HOST=localhost

# Mongo is published on this computer only. Set MONGO_BIND=0.0.0.0 to open it.
MONGO_BIND=127.0.0.1
MONGO_PORT=27017
API_CONTAINER_PORT=4000

# Public API. Interns can reach this from any address.
PUBLIC_API_BIND=0.0.0.0
PUBLIC_API_PORT=4000
PUBLIC_CORS_ORIGIN=

# Staff API. Set STAFF_API_BIND and STAFF_HOST to 0.0.0.0 for LAN access.
STAFF_API_BIND=0.0.0.0
STAFF_API_PORT=4001
STAFF_CORS_ORIGIN=
# For Docker Compose, private LAN access is enabled by default. Restrict this
# to a CIDR such as 192.168.1.0/24 for a narrower office network.
STAFF_ALLOWED_IPS=
STAFF_ALLOW_PRIVATE=true
TRUST_PROXY=false

# Vercel AI Gateway. Leave the key empty to disable AI features locally.
AI_GATEWAY_API_KEY=
AI_MODEL=deepseek/deepseek-v4.1-flash
AI_FILE_MODEL=google/gemini-3.5-flash-lite

# `ssh railway.new` creates the temporary review VM and OpenCode is preinstalled.
RAILWAY_NEW_SSH_PRIVATE_KEY_B64=
RAILWAY_NEW_SSH_KEY_PATH=

# Sites. Keep these aligned with the ports above.
WEB_HOST=0.0.0.0
WEB_PORT=3000
APP_URL=
VITE_PUBLIC_API_URL=
APP_TIMEZONE=Asia/Dhaka

STAFF_HOST=0.0.0.0
STAFF_PORT=3001
STAFF_APP_URL=
VITE_STAFF_API_URL=

# Optional Jenkins container. Start it with:
# docker compose --profile jenkins up -d --build jenkins
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000
# Linux hosts usually use 999; set this to the group ID of /var/run/docker.sock
# when Jenkins jobs need to build container images.
DOCKER_GID=999

# Uploads. Files land under /data/uploads/YYYY/MM/DD in the backend
# containers (named volume uploads-data). Override locally if needed.
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=10
