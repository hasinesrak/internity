# Copy this file to .env. Docker Compose reads .env from this directory.

HOST=0.0.0.0
API_CONTAINER_PORT=4000

# Public API. Interns can reach this from any address.
PUBLIC_API_BIND=0.0.0.0
PUBLIC_API_PORT=4000
PUBLIC_CORS_ORIGIN=http://localhost:3000

# Staff API. STAFF_API_BIND is the interface the port is published on.
# STAFF_ALLOWED_IPS is the office address. Leave it empty in development to allow this computer only.
STAFF_API_BIND=127.0.0.1
STAFF_API_PORT=4001
STAFF_CORS_ORIGIN=http://localhost:3001
STAFF_ALLOWED_IPS=
# Docker Compose sets this so the staff API sees the Docker bridge as this machine.
# Leave it unset when the API runs directly on the host, and never set it in production.
STAFF_ALLOW_PRIVATE=
TRUST_PROXY=false

# Sites. Keep these aligned with the ports above.
WEB_HOST=0.0.0.0
WEB_PORT=3000
APP_URL=http://localhost:3000

STAFF_HOST=127.0.0.1
STAFF_PORT=3001
STAFF_APP_URL=http://localhost:3001

# Uploads. Files land under /data/uploads/YYYY/MM/DD in the backend
# containers (named volume uploads-data). Override locally if needed.
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=10
