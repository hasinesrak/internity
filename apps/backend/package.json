{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./src/test/env.ts --test src/lib/client-ip.test.ts src/lib/rate-limit.test.ts src/app.test.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "ai": "^7.0.101",
    "bcryptjs": "^2.4.3",
    "hono": "^4.13.8",
    "jose": "^5.10.0",
    "mongoose": "^8.24.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
