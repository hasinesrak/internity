HOST=0.0.0.0
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/internity
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
STAFF_APP_URL=http://localhost:3001
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# public registers intern, auth, and department routes.
# staff registers those plus admin, HR, supervisor, and instructor routes.
# Development and tests default to staff. Production must set this.
API_SURFACE=staff

# Comma-separated office addresses. The staff process allows staff sign-in only from these addresses.
# Leave this empty in development to allow this computer only. Production will not start the staff process until it is set.
# The public process refuses staff sign-in either way.
STAFF_ALLOWED_IPS=
# Set true only for Docker Compose on this machine. Leave unset on the host and in production.
STAFF_ALLOW_PRIVATE=
TRUST_PROXY=false

# Leave the key empty to log invitation and reset links instead of sending them.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Internity <beth.t@example.com>

# Leave the key empty to disable drafting. The rest of the API keeps running.
# GROQ_MODEL is the first model. An admin can change it later from Settings.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Used once, when the database has no admin yet.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@internity.local
ADMIN_PASSWORD=
