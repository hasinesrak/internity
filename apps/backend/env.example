HOST=0.0.0.0
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/internity
# This template runs the default staff surface. Use localhost:3000 when running
# the same process with API_SURFACE=public.
CORS_ORIGIN=http://localhost:3001
APP_URL=http://localhost:3000
STAFF_APP_URL=http://localhost:3001
APP_TIMEZONE=Asia/Dhaka
# At least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# public registers intern, auth, and department routes.
# staff registers those plus admin, HR, supervisor, and instructor routes.
# Development and tests default to staff. Production must set this.
API_SURFACE=staff

# Comma-separated client addresses. Local development uses the loopback address.
# Production also requires this value to be set.
# The public process refuses staff sign-in either way.
STAFF_ALLOWED_IPS=127.0.0.1
# Set true only for Docker Compose on this machine. Leave unset on the host and in production.
STAFF_ALLOW_PRIVATE=
TRUST_PROXY=false

# Leave the key empty in development to log invitation and reset links.
# Production refuses those links until this key is set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Internity <beth.t@example.com>

# Leave the key empty to disable AI features. The rest of the API keeps running.
# AI_MODEL is the initial Vercel AI Gateway model. An admin can change the model
# and provider later from Settings.
AI_GATEWAY_API_KEY=
AI_MODEL=deepseek/deepseek-v4.1-flash

# Used once, when the database has no admin yet.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@internity.local
ADMIN_PASSWORD=
