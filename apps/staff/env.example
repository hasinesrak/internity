# Copy this file to apps/staff/.env. The dev server reads it from there.

STAFF_HOST=127.0.0.1
STAFF_PORT=3001
VITE_API_URL=http://localhost:4001

# Same office list as the staff API. Leave empty in development to allow this computer only.
STAFF_ALLOWED_IPS=
# Set true only for Docker Compose on this machine. Leave unset on the host and in production.
STAFF_ALLOW_PRIVATE=
TRUST_PROXY=false
