# Copy this file to apps/staff/.env. The dev server reads it from there.

STAFF_HOST=127.0.0.1
STAFF_PORT=3001
# For a LAN deployment, use STAFF_HOST=0.0.0.0 and replace localhost below
# with the server's LAN IPv4 address, for example http://192.168.1.25:4001.
VITE_API_URL=http://localhost:4001

# Same client allowlist as the staff API. Local development uses loopback.
STAFF_ALLOWED_IPS=127.0.0.1
# Set true only for Docker Compose on this machine. Leave unset on the host and in production.
STAFF_ALLOW_PRIVATE=
TRUST_PROXY=false
